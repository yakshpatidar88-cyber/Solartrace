# Solatrace Environment Configuration Template
# Copy to .env for local customized docker-compose deployments

POSTGRES_DB=solatrace_db
POSTGRES_USER=solatrace_user
POSTGRES_PASSWORD=solatrace_secure_password
POSTGRES_PORT=5432

REDIS_PORT=6379

ANALYTICS_PORT=8000
ANALYTICS_SERVICE_URL=http://analytics:8000

BACKEND_PORT=8080
FRONTEND_PORT=3000

SPRING_PROFILES_ACTIVE=prod
